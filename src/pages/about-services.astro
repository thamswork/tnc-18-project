---
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';
import Header from '../components/v6/Header.astro';
import Footer from '../components/v6/Footer.astro';
import PageHead from '../components/v6/PageHead.astro';
import { getCollection } from 'astro:content';
import { cld, cldSet } from '../lib/cld';
import { getProjects, projectName, projectPlace, projectUrl } from '../lib/projects';
import pageData from '../content/pages/about-services.json';
import docs from '../content/settings/documents.json';

const page: any = pageData;
const services = (await getCollection('services')).sort((a: any, b: any) => a.data.order - b.data.order);
const projects: any[] = await getProjects();
const two = (n: number) => String(n).padStart(2, '0');
const delay = (i: number, step = 0.08) => `--d:${(Math.min(i, 5) * step).toFixed(2)}s`;
const nameOf = (p: any) => String(projectName(p) || '');
const placeOf = (p: any) => String(projectPlace(p) || '');
const coverOf = (p: any) => String(p?.data?.cover || '').trim();
const named = (s: string) => projects.filter((p) => nameOf(p).toLowerCase().includes(s) && coverOf(p));
const used = new Set<any>();
const pick = (...cands: any[]) => {
  const p = cands.find((x) => x && !used.has(x)) || projects.find((x) => coverOf(x) && !used.has(x));
  if (p) used.add(p);
  return p;
};
const pinn = named('rolling pinn');
const pMain = pick(pinn.find((p) => placeOf(p).toLowerCase().includes('central')), pinn[0]);
const pLeft = pick(...pinn);
const pRight = pick(...named('irvin'));
const photo = (own: any, p: any) => {
  const o = String(own || '').trim();
  if (o) return { src: o, alt: '', p: null };
  return p ? { src: coverOf(p), alt: nameOf(p), p } : null;
};
const hero = photo(page.hero_image, pMain);
// Slideshow lanes: own CMS photo first, then the board's project, then other projects split left/right
const rest = projects.filter((p) => coverOf(p) && p !== pMain && p !== pLeft && p !== pRight).slice(0, 10);
const lane = (own: any, lead: any, k: number) => {
  const list: any[] = [];
  const o = photo(own, null); if (o) list.push(o);
  if (lead) list.push(photo(null, lead));
  rest.forEach((p, i) => { if (i % 2 === k) list.push(photo(null, p)); });
  return list;
};
const lanes = [lane(page.photo_2, pLeft, 0), lane(page.photo_3, pRight, 1)].filter((l) => l.length);
const caption = (p: any) => nameOf(p) + (placeOf(p) ? `, ${placeOf(p)}` : '');

const founded = String(page.founded || '').trim();
const years = /^\d{4}$/.test(founded) ? String(new Date().getFullYear() - Number(founded)) : page.years;
const stats = [
  { l: 'Years', v: years },
  { l: 'Projects', v: page.projects },
].filter((s) => String(s.v || '').trim());
const aside = `${site.company}. Design and build in Bangkok${founded ? ` since ${founded}` : ''}.`;
const statement = page.statement || 'We design and build interiors that have to open on a fixed date and still last. The people who draw your project are the people who build it.';
const dbd = String((docs as any).dbd_pdf || '').trim();
const isPdf = /\.pdf(\?|#|$)/i.test(dbd);

const steps = [
  { t: 'Brief and site survey', d: 'Scope, budget range and opening date agreed on site.' },
  { t: 'Design and quotation', d: 'Layout, 3D views and a fixed quote.' },
  { t: 'Fabrication and build', d: 'Joinery made off-site while the site is prepared.' },
  { t: 'Handover', d: 'Snag list closed, documents handed over.' },
];
---
<Layout
  title="Studio — ออกแบบและรับเหมาตกแต่งภายใน กรุงเทพฯ"
  description="TNC Build Studio บริษัทออกแบบและรับเหมาตกแต่งภายในร้านค้าและพื้นที่เชิงพาณิชย์ในกรุงเทพฯ | Design and build studio for retail and commercial interiors in Bangkok."
  bodyClass="v6">
  <Header active="studio" />
  <main class="s-page">
    <PageHead title="Studio" aside={aside} />

    {hero && (
      <figure class="s-hero">
        <picture>
          <source media="(max-width: 767px)" srcset={cldSet(hero.src, [480, 800, 1200], 4 / 5)} sizes="100vw" />
          <img src={cld(hero.src, { w: 2400, h: 1134 })} srcset={cldSet(hero.src, [1200, 1800, 2400], 2400 / 1134)} sizes="100vw" alt={hero.alt} fetchpriority="high" />
        </picture>
        {hero.p && <figcaption class="s-cap"><a href={projectUrl(hero.p)}>{caption(hero.p)}</a></figcaption>}
      </figure>
    )}

    <section class="t-wrap s-block s-intro">
      <p class="s-statement s-rv">{statement}</p>
      {stats.length > 0 && (
        <dl class="s-stats">
          {stats.map((s, i) => (
            <div class="s-rv" style={delay(i + 1, 0.12)}><dt>{s.l}</dt><dd class="t-num">{s.v}</dd></div>
          ))}
        </dl>
      )}
    </section>

    <section class="s-paper">
      <div class="t-wrap s-block">
        <div class="s-group" aria-labelledby="s-services">
          <div class="s-head s-rv">
            <h2 id="s-services">Services</h2>
            <p>From first drawing to handover.</p>
          </div>
          <ol class="s-rows">
            {services.map((s: any, i: number) => (
              <li class="s-row s-rv" style={delay(i, 0.06)}>
                <span class="s-row-main"><span class="s-n t-num">{two(s.data.order || i + 1)}</span><span class="s-row-t">{s.data.title}</span></span>
                {s.data.description && <span class="s-row-d">{s.data.description}</span>}
              </li>
            ))}
          </ol>
        </div>

        {dbd && (
          <div class="s-group" aria-labelledby="s-reg">
            <div class="s-head s-rv">
              <h2 id="s-reg">Company registration</h2>
              <p>Department of Business Development, Ministry of Commerce, Thailand.</p>
            </div>
            <div class="s-row s-rv">
              <span class="s-row-main">
                <span class="s-n" aria-hidden="true"></span>
                <a class="s-doc-file" href={dbd} target="_blank" rel="noopener" aria-label="Open the company certificate">
                  {isPdf ? <span class="s-doc-pdf">PDF</span> : <img src={cld(dbd, { w: 480 })} alt="" loading="lazy" decoding="async" />}
                </a>
              </span>
              <span class="s-row-d s-doc-text">
                <span class="s-row-t">Company certificate <span lang="th">(หนังสือรับรอง)</span></span>
                <a class="t-link" href={dbd} target="_blank" rel="noopener">View full document <span aria-hidden="true">→</span></a>
              </span>
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="t-wrap s-block" aria-labelledby="s-process">
      <div class="s-head s-head--dark s-rv">
        <h2 id="s-process">How a project runs</h2>
        <p>The same team from the first site visit to handover.</p>
      </div>
      <ol class="s-steps">
        {steps.map((s, i) => (
          <li class="s-rv" style={delay(i, 0.1)}>
            <span class="s-n t-num">{two(i + 1)}</span>
            <span class="s-row-t">{s.t}</span>
            <span class="s-step-d">{s.d}</span>
          </li>
        ))}
      </ol>
    </section>

    {lanes.length > 0 && (
      <div class="s-pair">
        {lanes.map((slides, t) => (
          <div class="s-tile s-rv" style={delay(t, 0.15)} data-rot>
            {slides.map((ph: any, k: number) => {
              const set = cldSet(ph.src, [480, 800, 1200], 4 / 5);
              const one = cld(ph.src, { w: 1200, h: 1500 });
              return (
                <figure class:list={["s-slide", { "is-on": k === 0 }]} aria-hidden={k === 0 ? undefined : "true"}>
                  {k === 0
                    ? <img src={one} srcset={set} sizes="(min-width: 600px) 50vw, 100vw" alt={ph.alt} loading="lazy" decoding="async" />
                    : <img data-src={one} data-srcset={set} sizes="(min-width: 600px) 50vw, 100vw" alt={ph.alt} decoding="async" />}
                  {ph.p && <figcaption class="s-cap s-cap--tile"><a href={projectUrl(ph.p)}>{caption(ph.p)}</a></figcaption>}
                </figure>
              );
            })}
          </div>
        ))}
      </div>
    )}
  </main>
  <Footer />
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.s-rv');
      if (!els.length || !('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('s-js');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
  <script is:inline>
    (function () {
      var tiles = document.querySelectorAll('[data-rot]');
      if (!tiles.length || !('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      function load(sl) {
        var im = sl.querySelector('img[data-src]');
        if (!im) return;
        im.srcset = im.getAttribute('data-srcset'); im.src = im.getAttribute('data-src');
        im.removeAttribute('data-src'); im.removeAttribute('data-srcset');
      }
      tiles.forEach(function (tile, t) {
        var slides = tile.querySelectorAll('.s-slide');
        if (slides.length < 2) return;
        var i = 0, visible = false, timer = null, wait = null;
        function next() {
          slides[i].classList.remove('is-on'); slides[i].setAttribute('aria-hidden', 'true');
          i = (i + 1) % slides.length;
          load(slides[i]);
          slides[i].classList.add('is-on'); slides[i].removeAttribute('aria-hidden');
          load(slides[(i + 1) % slides.length]);
        }
        function start() {
          if (timer || wait || !visible || document.hidden) return;
          load(slides[1]);
          wait = setTimeout(function () { wait = null; if (visible && !document.hidden) timer = setInterval(next, 3000); }, t * 1500);
        }
        function stop() { clearInterval(timer); clearTimeout(wait); timer = null; wait = null; }
        new IntersectionObserver(function (es) {
          visible = es[0].isIntersecting;
          visible ? start() : stop();
        }, { threshold: 0.2 }).observe(tile);
        document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
      });
    })();
  </script>
</Layout>

<style>
  /* One rhythm for the whole page */
  .s-page { --s-pad: clamp(64px, 7vw, 112px); --s-group: clamp(72px, 7vw, 112px); --s-row: 24px; --s-num: 48px; --s-rule: #D6D4CC; }

  .s-hero, .s-tile { position: relative; margin: 0; background: var(--tile); overflow: hidden; }
  .s-hero img { display: block; width: 100%; aspect-ratio: 2400 / 1134; max-height: 680px; object-fit: cover; }
  .s-cap { position: absolute; left: var(--m); bottom: 20px; right: var(--m); font-size: 12px; line-height: 1.4; }
  .s-cap a { color: #fff; text-shadow: 0 1px 10px rgba(0,0,0,.55); }
  .s-cap a:hover { color: var(--soft); }
  .s-cap--tile { left: 16px; right: 16px; bottom: 14px; }

  .s-block { padding-block: var(--s-pad); }

  .s-intro { display: flex; flex-wrap: wrap; gap: 40px var(--gap); align-items: flex-end; justify-content: space-between; }
  .s-statement { margin: 0; flex: 1 1 min(100%, 560px); max-width: 30ch; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.35; font-weight: 300; letter-spacing: -.015em; }
  .s-stats { margin: 0; flex: 0 1 320px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--gap); }
  .s-stats div { padding-top: 16px; border-top: 1px solid var(--line-2); }
  .s-stats dt { font-size: 13px; color: var(--mute); }
  .s-stats dd { margin: 4px 0 0; font-size: 20px; font-weight: 500; }

  /* Section heading: title left, note on the centre line, one solid rule */
  .s-head { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px var(--gap); align-items: baseline; padding-bottom: 24px; border-bottom: 1px solid var(--blue); }
  .s-head h2 { margin: 0; font-size: clamp(24px, 2.2vw, 32px); line-height: 1.15; font-weight: 400; letter-spacing: -.02em; }
  .s-head p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--grey); }
  .s-head--dark { border-bottom-color: rgba(255,255,255,.35); }
  .s-head--dark p { color: var(--mute); }
  .s-group + .s-group { margin-top: var(--s-group); }

  /* Rows: number + title in the left half, detail from the centre line */
  .s-paper { background: var(--paper); color: var(--blue); }
  .s-rows { margin: 0; padding: 0; list-style: none; }
  .s-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px var(--gap); align-items: baseline; padding-block: var(--s-row); border-bottom: 1px solid var(--s-rule); }
  .s-row-main { display: grid; grid-template-columns: var(--s-num) minmax(0, 1fr); align-items: baseline; }
  .s-n { font-size: 13px; font-variant-numeric: tabular-nums; color: var(--grey); }
  .s-row-t { font-size: 20px; font-weight: 500; letter-spacing: -.01em; line-height: 1.3; }
  .s-row-d { font-size: 15px; line-height: 1.5; color: var(--grey); }

  .s-row:has(.s-doc-file) { align-items: start; }
  .s-row:has(.s-doc-file) .s-row-main { align-items: start; }
  .s-doc-file { display: block; width: 120px; aspect-ratio: 4 / 5; overflow: hidden; background: #fff; border: 1px solid var(--s-rule); box-shadow: 0 8px 24px -14px rgba(12,31,74,.25); transition: transform .6s cubic-bezier(.16,1,.3,1), box-shadow .6s cubic-bezier(.16,1,.3,1); }
  .s-doc-file img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .s-doc-file:hover { transform: translateY(-3px); box-shadow: 0 14px 30px -14px rgba(12,31,74,.35); }
  .s-doc-pdf { display: grid; place-items: center; height: 100%; font-size: 13px; color: var(--grey); }
  .s-doc-text { display: grid; gap: 4px; justify-items: start; }
  .s-doc-text .s-row-t { color: var(--blue); }
  .s-doc-text .t-link { color: var(--blue); display: inline-block; padding-block: 12px; }

  /* Steps share the same centre line (4 columns = 2 per half) */
  .s-steps { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px var(--gap); }
  .s-steps li { display: grid; gap: 8px; align-content: start; padding-top: var(--s-row); }
  .s-steps .s-n { color: var(--mute); margin-bottom: 12px; }
  .s-step-d { font-size: 15px; line-height: 1.5; color: var(--mute); }

  .s-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; }
  .s-tile { aspect-ratio: 4 / 5; }
  .s-slide { position: absolute; inset: 0; margin: 0; opacity: 0; pointer-events: none; transition: opacity .6s cubic-bezier(.4,0,.2,1); }
  .s-slide.is-on { opacity: 1; z-index: 1; pointer-events: auto; }
  .s-slide img { display: block; width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); transition: transform 3.5s linear; }
  .s-slide.is-on img { transform: none; }
  @media (prefers-reduced-motion: reduce) { .s-slide, .s-slide img { transition: none; transform: none; } }

  /* Subtle motion: page head rises in, photo settles, sections fade up on scroll */
  :global(html.s-js) .s-rv { opacity: 0; transform: translateY(18px); transition: opacity 1.1s cubic-bezier(.16,1,.3,1) var(--d, 0s), transform 1.1s cubic-bezier(.16,1,.3,1) var(--d, 0s); }
  :global(html.s-js) .s-rv.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .s-hero img { animation: s-settle 2.8s cubic-bezier(.16,1,.3,1) both; }
    .s-page :global(.t-pagehead-main), .s-page :global(.t-pagehead-aside) { animation: s-rise 1.1s cubic-bezier(.16,1,.3,1) both; }
    .s-page :global(.t-pagehead-aside) { animation-delay: .15s; }
  }
  @keyframes s-settle { from { transform: scale(1.05); } to { transform: none; } }
  @keyframes s-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1023px) {
    .s-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .s-page { --s-num: 40px; --s-row: 20px; }
    .s-hero img { aspect-ratio: 4 / 5; max-height: 78svh; }
    .s-stats { flex: 1 1 100%; }
    .s-head, .s-row { grid-template-columns: minmax(0, 1fr); }
    .s-row-d { padding-left: var(--s-num); }
    .s-row-t { font-size: 18px; }
    .s-doc-file { width: 104px; }
  }
  @media (max-width: 599px) {
    .s-steps { grid-template-columns: 1fr; gap: 8px; }
    .s-steps li { padding-bottom: 8px; }
    .s-pair { grid-template-columns: 1fr; }
  }
</style>
