---
import fs from "node:fs";
import Layout from "../layouts/Layout.astro";
import Header from "../components/v6/Header.astro";
import Footer from "../components/v6/Footer.astro";
import SectionHead from "../components/v6/SectionHead.astro";
import ProjectCard from "../components/v6/ProjectCard.astro";
import { getCollection } from "astro:content";
import homepageData from "../content/pages/homepage.json";
import { cld, cldSet } from "../lib/cld";
import { getProjects, projectUrl, projectName, projectMeta } from "../lib/projects";

const home: any = homepageData;
const projects = await getProjects();

// Hero: same rules as before (slideshow or single image; separate mobile image and crop).
const slides: { d: string; m: string; pd: string; pm: string }[] = (home.hero_slides && home.hero_slides.length > 0)
  ? home.hero_slides
      .map((s: any) => typeof s === "string" ? { d: s, m: s, pd: "", pm: "" } : { d: s.image, m: s.image_mobile || s.image, pd: s.position || "", pm: s.position_mobile || "" })
      .filter((s: any) => s.d)
  : home.hero_image
    ? [{ d: home.hero_image, m: home.hero_image_mobile || home.hero_image, pd: home.hero_position || "", pm: home.hero_position_mobile || "" }]
    : [];

const intro = home.intro || "TNC is a design and build studio in Bangkok. We make shops, pop-ups, exhibition pavilions, clinics and homes, and run every project ourselves, from the first drawing to handover.";

const heroTitle = home.hero_title || home.hero_headline || home.headline || home.hero_heading || "We build\nwhat works.";
const heroKicker = home.hero_eyebrow || home.hero_kicker || home.hero_label || home.eyebrow || "Bangkok · Thailand";

const heroLines = String(heroTitle).split(/\n|<br\s*\/?>/i).map((s) => s.trim()).filter(Boolean);

const introMatch = String(intro).match(/^[^.!?]+[.!?]/);
const introFirst = introMatch ? introMatch[0] : intro;
const introRest = introMatch ? String(intro).slice(introMatch[0].length).trim() : "";
const steps = [
  { t: "Design", d: "Layout, 3D views and a fixed quote" },
  { t: "Joinery", d: "Made in our own workshop" },
  { t: "Build", d: "On site, on the agreed date" },
  { t: "Handover", d: "Snag list closed, documents handed over" },
];

const large = projects.slice(0, 2);
// Selected work: first six projects in the Works order
const feat = projects.slice(0, 6);
const years = projects.map((p: any) => Number(p.data.year)).filter(Boolean);
const yearMin = Math.min(...years), yearMax = Math.max(...years);
const facts = (p: any) => {
  const size = String(p.data.size ?? "").trim();
  const area = size ? (/^\d+(\.\d+)?$/.test(size) ? `${size} m²` : size) : "";
  const n = Array.isArray(p.data.gallery) ? p.data.gallery.length : 0;
  return [area, n ? `${n} photos` : ""].filter(Boolean).join(" · ");
};
const sel = projects.slice(0, 6);
// Six grid slots, each swapping between three projects (Works order)
const groups = [0, 1, 2, 3, 4, 5].map((j) => [j, j + 6, j + 12].map((i) => projects[i]).filter(Boolean));
const small = projects.slice(2, 6);
const show = (projects.length > 6 ? projects.slice(6, 11) : projects.slice(0, 5));

const byCat = new Map<string, any[]>();
for (const p of projects) {
  const c = String(p.data.category ?? "").trim();
  if (!c) continue;
  if (!byCat.has(c)) byCat.set(c, []);
  byCat.get(c)!.push(p);
}
const cats = [...byCat.entries()]
  .sort((a, b) => b[1].length - a[1].length)
  .map(([name, list], i) => ({ name, count: list.length, cover: list[0].data.cover, n: String(i + 1).padStart(2, "0") }));

// Mall logos: same CMS collection and heading as the current "Trusted By" strip.
const logos = (await getCollection("trusted_by" as any))
  .map((e: any) => e.data)
  .filter((l: any) => l.logo && String(l.logo).trim() !== "");
let logoLabel = "Trusted by";
try {
  const sp = "src/content/trusted-by/settings.json";
  if (fs.existsSync(sp)) logoLabel = JSON.parse(fs.readFileSync(sp, "utf-8")).section_label || logoLabel;
} catch (e) {}

const isDraft = (e: any) => !!e.filePath && /^draft:\s*true/m.test(fs.readFileSync(e.filePath, "utf-8"));
const allPosts = (await getCollection("specbook")).filter((e: any) => !isDraft(e));
const thPosts = allPosts.filter((e: any) => e.id.startsWith("th-"));
const posts = allPosts
  .filter((e: any) => !e.id.startsWith("th-"))
  .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3)
  .map((p: any) => ({ p, th: thPosts.find((t: any) => t.data.date === p.data.date && (t.data.category ?? "") === (p.data.category ?? "")) }));
const showSpecbook = false; // Specbook teaser hidden on Home for now
const fmtDate = (d: string) => new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const two = (n: number) => String(n).padStart(2, "0");
---
<Layout title="TNC Build Studio — ผู้รับเหมาตกแต่งภายใน บูธขายของในห้าง Pop-up Store กรุงเทพ" description="TNC Build Studio รับเหมาตกแต่งภายใน ออกแบบบูธขายของในห้าง Pop-up Store ตกแต่งร้านค้า คีออสก์ บูธนิทรรศการ กรุงเทพ | Interior fit-out & retail booth design Bangkok Thailand" bodyClass="v6">
  <Header overlay />
  <main>

    <section class="h-hero" aria-labelledby="h-hero-title">
      <div class="h-hero-stage">
        {slides.map((s, i) => (
          <picture class:list={["h-hero-slide", { "is-on": i === 0 }]}>
            <source media="(max-width: 600px)" srcset={cld(s.m, { w: 1000 })} />
            <img src={cld(s.d, { w: 2400 })} srcset={cldSet(s.d, [1200, 1800, 2400])} sizes="100vw"
              alt="" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined}
              style={`--pd:${s.pd || "center center"};--pm:${s.pm || s.pd || "center center"}`} />
          </picture>
        ))}
        <div class="h-hero-over">
          <div class="h-hero-text">
            <p class="h-hero-kicker">{heroKicker}</p>
            <h1 class="h-hero-title" id="h-hero-title">{heroLines.map((l, i) => <span class="h-line"><span style={`--d:${(0.55 + i * 0.18).toFixed(2)}s`}>{l}</span></span>)}</h1>
            <div class="h-hero-ctas">
              <a class="h-hero-btn h-hero-btn--solid" href="/about-services">More about us <span aria-hidden="true">→</span></a>
              <a class="h-hero-btn" href="#h-work">View work <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          {slides.length > 1 && (
            <div class="h-hero-bar" aria-hidden="true">
              <span class="h-bars">{slides.map((_, i) => <span class:list={["h-bar", { "is-on": i === 0 }]}><i></i></span>)}</span>
              <span class="t-num h-hero-count">01 / {two(slides.length)}</span>
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="t-wrap h-intro" aria-labelledby="h-intro">
      <h2 class="h-intro-label" id="h-intro" data-reveal>The studio</h2>
      <div class="h-intro-body">
        <p class="h-intro-lead" data-reveal style="--d:.12s">{introFirst}{introRest && <span> {introRest}</span>}</p>
        <ol class="h-steps">
          {steps.map((s, i) => (
            <li data-reveal style={`--d:${(0.25 + i * 0.1).toFixed(2)}s`}>
              <span class="h-step-n t-num">{two(i + 1)}</span>
              <span class="h-step-t">{s.t}</span>
              <span class="h-step-d">{s.d}</span>
            </li>
          ))}
        </ol>
        <a class="t-link h-intro-link" href="/about-services" data-reveal style="--d:.6s">About the studio <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="h-feat" aria-labelledby="h-work" data-feat>
      <div class="h-feat-bg" aria-hidden="true">
        {feat.map((p, i) => (
          <img class:list={["h-feat-img", { "is-on": i === 0 }]} src={cld(p.data.cover, { w: 2400, h: 1350 })}
            srcset={cldSet(p.data.cover, [1200, 1800, 2400], 16 / 9)} sizes="100vw" alt=""
            loading={i === 0 ? "eager" : "lazy"} decoding="async" />
        ))}
      </div>
      <div class="t-wrap h-feat-in">
        <div class="h-feat-head" data-reveal>
          <div>
            <h2 class="h-feat-title" id="h-work">Selected work</h2>
            <p class="h-feat-sub">{projects.length} projects · {yearMin === yearMax ? yearMax : `${yearMin}–${yearMax}`}</p>
          </div>
          <a class="t-link" href="/portfolio">View all work <span aria-hidden="true">→</span></a>
        </div>
        <ol class="h-feat-list">
          {feat.map((p, i) => (
            <li data-reveal style={`--d:${(0.1 + i * 0.08).toFixed(2)}s`}>
              <a class:list={["h-feat-row", { "is-on": i === 0 }]} href={projectUrl(p)}>
                <span class="h-feat-n t-num">{two(i + 1)}</span>
                <span class="h-feat-name">{projectName(p)}</span>
                <span class="h-feat-meta">{projectMeta(p)}{facts(p) && <span class="h-feat-facts"> · {facts(p)}</span>}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="h-build" aria-labelledby="h-build">
      <div class="t-wrap">
        <SectionHead id="h-build" label="What we build" sub="Five kinds of space, one team from drawing to handover." href="/portfolio" linkText="Browse by type" />
      </div>
      <div class="h-cats" style={`--cols:${cats.length}`}>
        {cats.map((c) => (
          <a class="h-cat" href="/portfolio">
            {c.cover && <img src={cld(c.cover, { w: 700, h: 1100 })} srcset={cldSet(c.cover, [400, 700, 1000], 7 / 11)} sizes="(max-width: 600px) 80vw, 20vw" alt="" loading="lazy" decoding="async" />}
            <span class="h-cat-top t-num">{c.n}</span>
            <span class="h-cat-bottom"><span class="h-cat-name">{c.name}</span><span class="h-cat-count">{c.count} {c.count === 1 ? "project" : "projects"}</span></span>
          </a>
        ))}
      </div>
    </section>

    {logos.length > 0 && (
      <section class="t-paper h-logos" aria-labelledby="h-logos">
        <div class="t-wrap">
          <SectionHead id="h-logos" label={logoLabel} sub="The malls where our projects stand." note={`${logos.length} malls across Bangkok`} />
          <ul class="h-logos-row">
            {logos.map((l: any) => (
              <li>
                {l.url
                  ? <a href={l.url} target="_blank" rel="noopener noreferrer"><img src={l.logo} alt={l.name} loading="lazy" decoding="async" /></a>
                  : <img src={l.logo} alt={l.name} loading="lazy" decoding="async" />}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {show.length > 0 && (
      <section class="h-show" aria-label="Project showcase" aria-roledescription="carousel" data-show>
        <div class="h-show-stage">
          {show.map((p, i) => (
            <a class:list={["h-show-slide", { "is-on": i === 0 }]} href={projectUrl(p)} aria-hidden={i === 0 ? undefined : "true"} tabindex={i === 0 ? undefined : -1}>
              <img src={cld(p.data.cover, { w: 2400, h: 1100 })} srcset={cldSet(p.data.cover, [1200, 1800, 2400], 24 / 11)} sizes="100vw" alt={projectName(p)} loading="lazy" decoding="async" />
              <span class="h-show-text">
                <span class="h-show-n t-num">{two(i + 1)} / {two(show.length)}</span>
                <span class="h-show-t">{projectName(p)}</span>
                <span class="h-show-m">{projectMeta(p)}</span>
              </span>
            </a>
          ))}
        </div>
        <div class="t-wrap h-show-bar">
          <span class="h-bars" aria-hidden="true">{show.map((_, i) => <span class:list={["h-bar", { "is-on": i === 0 }]}><i></i></span>)}</span>
          <span class="t-meta t-num" data-count>01 / {two(show.length)}</span>
          <a class="t-link" href={projectUrl(show[0])} data-link>View project</a>
          <span class="h-show-btns">
            <button class="h-btn" type="button" data-prev aria-label="Previous project"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
            <button class="h-btn" type="button" data-next aria-label="Next project"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></button>
          </span>
        </div>
      </section>
    )}

    {showSpecbook && posts.length > 0 && (
      <section class="t-paper h-spec" aria-labelledby="h-spec">
        <div class="t-wrap">
          <SectionHead id="h-spec" label="From the Specbook" href="/specbook" linkText="All articles" />
          <div class="t-grid t-grid--3">
            {posts.map(({ p, th }) => (
              <a class="t-card" href={`/specbook/${p.id}`}>
                <div class="t-ph" style="aspect-ratio:3/2">
                  {p.data.cover && <img src={cld(p.data.cover, { w: 800, h: 533 })} alt="" loading="lazy" decoding="async" />}
                </div>
                <span class="t-meta">{p.data.category ? `${p.data.category} · ` : ""}{fmtDate(p.data.date)}</span>
                <span class="t-card-text">
                  <span class="t-title" lang="en">{p.data.title}</span>
                  {th && <span class="h-th" lang="th">{th.data.title}</span>}
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

  </main>
  <Footer />
</Layout>

<script>
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  // Gentle fade-up for the intro as it scrolls into view
  if (!still && "IntersectionObserver" in window) {
    document.documentElement.classList.add("h-js");
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
    }), { threshold: 0.2, rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
  }
  function bars(root: Element, k: number) {
    root.querySelectorAll(".h-bar").forEach((b, i) => {
      b.classList.remove("is-on");
      b.classList.toggle("is-done", i < k);
      if (i === k) { void (b as HTMLElement).offsetWidth; b.classList.add("is-on"); }
    });
  }
  // Hero rotation (only when there is more than one slide)
  const hero = document.querySelector(".h-hero");
  const heroSlides = hero ? [...hero.querySelectorAll(".h-hero-slide")] : [];
  if (hero && heroSlides.length > 1 && !still) {
    let k = 0;
    const count = hero.querySelector(".h-hero-count");
    setInterval(() => {
      k = (k + 1) % heroSlides.length;
      heroSlides.forEach((s, i) => s.classList.toggle("is-on", i === k));
      bars(hero, k);
      if (count) count.textContent = `${String(k + 1).padStart(2, "0")} / ${String(heroSlides.length).padStart(2, "0")}`;
    }, 6000);
  }
  // Selected work: hover a name to bring its photo full-bleed; idles through the list
  const feat = document.querySelector<HTMLElement>("[data-feat]");
  if (feat) {
    const imgs = [...feat.querySelectorAll(".h-feat-img")];
    const rows = [...feat.querySelectorAll<HTMLAnchorElement>(".h-feat-row")];
    let k = 0;
    let inside = false;
    const go = (n: number) => {
      k = (n + rows.length) % rows.length;
      imgs.forEach((im, i) => im.classList.toggle("is-on", i === k));
      rows.forEach((r, i) => r.classList.toggle("is-on", i === k));
    };
    rows.forEach((r, i) => {
      r.addEventListener("mouseenter", () => go(i));
      r.addEventListener("focus", () => go(i));
    });
    feat.addEventListener("mouseenter", () => { inside = true; });
    feat.addEventListener("mouseleave", () => { inside = false; });
    if (!still) window.setInterval(() => { if (!inside) go(k + 1); }, 5000);
  }

  // Project showcase
  const show = document.querySelector("[data-show]");
  if (show) {
    const ss = [...show.querySelectorAll<HTMLAnchorElement>(".h-show-slide")];
    const count = show.querySelector("[data-count]");
    const link = show.querySelector<HTMLAnchorElement>("[data-link]");
    let k = 0;
    let timer: number | undefined;
    const go = (n: number) => {
      k = (n + ss.length) % ss.length;
      ss.forEach((s, i) => {
        const on = i === k;
        s.classList.toggle("is-on", on);
        if (on) { s.removeAttribute("aria-hidden"); s.removeAttribute("tabindex"); }
        else { s.setAttribute("aria-hidden", "true"); s.setAttribute("tabindex", "-1"); }
      });
      bars(show, k);
      if (count) count.textContent = `${String(k + 1).padStart(2, "0")} / ${String(ss.length).padStart(2, "0")}`;
      if (link) link.href = ss[k].href;
    };
    const start = () => { if (still) return; window.clearInterval(timer); timer = window.setInterval(() => go(k + 1), 5000); };
    show.querySelector("[data-prev]")?.addEventListener("click", () => { go(k - 1); start(); });
    show.querySelector("[data-next]")?.addEventListener("click", () => { go(k + 1); start(); });
    start();
  }
</script>

<style>
  /* Hero: full bleed, headline on the photo (as on the current site) */
  .h-hero-stage { position: relative; height: 100svh; min-height: 600px; max-height: 1100px; overflow: hidden; background: var(--tile); }
  .h-hero-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.6s ease; }
  .h-hero-slide.is-on { opacity: 1; }
  .h-hero-slide img { width: 100%; height: 100%; object-fit: cover; object-position: var(--pd, center center); }
  .h-hero-slide.is-on img { animation: h-zoom 9s cubic-bezier(.2,.6,.2,1) both; }
  .h-hero-over { position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center; padding: 120px var(--m) 96px; text-align: center;
    background: linear-gradient(to bottom, rgba(8,22,56,.55) 0%, rgba(8,22,56,.28) 28%, rgba(8,22,56,.32) 62%, rgba(8,22,56,.68) 100%); }
  .h-hero-text { max-width: 920px; display: flex; flex-direction: column; align-items: center; }
  .h-hero-kicker { margin: 0 0 24px; font-size: 12px; font-weight: 500; letter-spacing: .32em; text-transform: uppercase; color: var(--soft); animation: h-track 2s cubic-bezier(.16,1,.3,1) .3s both; }
  .h-hero-title { margin: 0; font-weight: 800; font-size: clamp(40px, 5.6vw, 92px); line-height: .95; letter-spacing: -.045em; text-transform: uppercase; color: #fff; }
  .h-line { display: block; overflow: hidden; padding-bottom: .06em; }
  .h-line > span { display: block; animation: h-rise 1.6s cubic-bezier(.16,1,.3,1) var(--d, .55s) both; }
  .h-hero-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 16px; margin-top: clamp(32px, 3.6vw, 48px); animation: h-fade 1.4s cubic-bezier(.16,1,.3,1) 1.35s both; }
  .h-hero-btn { display: inline-flex; align-items: center; gap: 12px; height: 52px; padding: 0 26px; border: 1px solid rgba(255,255,255,.45); color: #fff; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; transition: background .3s ease, border-color .3s ease; }
  .h-hero-btn:hover { color: #fff; border-color: #fff; }
  .h-hero-btn--solid { background: var(--paper); border-color: var(--paper); color: var(--blue); }
  .h-hero-btn--solid:hover { background: #fff; border-color: #fff; color: var(--blue); }
  .h-hero-bar { position: absolute; left: 0; right: 0; bottom: 32px; display: flex; justify-content: center; align-items: center; gap: 16px; animation: h-fade 1.4s ease 1.7s both; }
  .h-hero-bar .h-bars { flex: 0 0 160px; }
  .h-hero-count { font-size: 13px; color: var(--soft); }
  @keyframes h-zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
  @keyframes h-track { from { opacity: 0; letter-spacing: .6em; } to { opacity: 1; letter-spacing: .32em; } }
  @keyframes h-rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes h-fade { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  /* Progress bars (hero and showcase) */
  .h-bars { display: flex; gap: 6px; flex: 1 1 200px; max-width: 360px; }
  .h-bar { flex: 1; height: 2px; background: var(--line-2); overflow: hidden; }
  .h-bar i { display: block; height: 100%; width: 0; background: #fff; }
  .h-bar.is-done i { width: 100%; }
  .h-bar.is-on i { animation: h-fill 5s linear forwards; }
  @keyframes h-fill { to { width: 100%; } }

  /* Intro: label + two-tone statement + four steps */
  .h-intro { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap); row-gap: 24px; padding-block: clamp(56px, 6vw, 96px) clamp(48px, 5vw, 80px); }
  .h-intro-label { grid-column: 1 / span 3; margin: 0; padding-top: 14px; font-size: 14px; font-weight: 400; color: var(--mute); }
  .h-intro-body { grid-column: 4 / span 8; }
  .h-intro-lead { margin: 0; max-width: 22em; font-size: clamp(22px, 2.2vw, 34px); line-height: 1.22; font-weight: 300; letter-spacing: -.02em; color: #fff; }
  .h-intro-lead span { color: var(--mute); }
  .h-steps { margin: clamp(36px, 3.6vw, 56px) 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px var(--gap); }
  .h-steps li { display: grid; gap: 6px; align-content: start; padding-top: 18px; border-top: 1px solid var(--line-2); }
  .h-step-n { font-size: 13px; color: var(--mute); margin-bottom: 14px; }
  .h-step-t { font-size: 18px; font-weight: 500; }
  .h-step-d { font-size: 14px; line-height: 1.5; color: var(--mute); }
  .h-intro-link { display: inline-block; margin-top: 40px; }
