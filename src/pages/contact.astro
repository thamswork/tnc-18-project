---
import Layout from '../layouts/Layout.astro';
import Header from '../components/v6/Header.astro';
import Footer from '../components/v6/Footer.astro';
import { cld, cldSet } from '../lib/cld';
import { getProjects, projectName, projectPlace, projectUrl } from '../lib/projects';
import { site } from '../data/site';
import contactData from '../content/settings/contact.json';
import pageData from '../content/pages/contact.json';

const pd: any = pageData;
const cd: any = contactData;
const projects: any[] = await getProjects();
const coverOf = (p: any) => String(p?.data?.cover || '').trim();
const nameOf = (p: any) => String(projectName(p) || '');
const placeOf = (p: any) => String(projectPlace(p) || '');
const curated = projects.find((p) => nameOf(p).toLowerCase().includes('curated') && coverOf(p)) || projects.find((p) => coverOf(p));
const own = String(pd.hero_image || '').trim();
const photo = own ? { src: own, p: null } : curated ? { src: coverOf(curated), p: curated } : null;

const intro = String(pd.intro || '').trim() || 'Send the location, size, opening date and budget. We reply with next steps.';
const email = String(cd.email || '').trim();
const socials = [
  { label: 'Instagram', href: String(cd.instagram || '').trim() },
  { label: 'TikTok', href: String(cd.tiktok || '').trim() },
  { label: 'Facebook', href: String(cd.facebook || '').trim() },
].filter((s) => s.href);
const delay = (i: number) => `--d:${(0.2 + i * 0.06).toFixed(2)}s`;
---
<Layout
  title="Contact — ติดต่อรับเหมาตกแต่งภายใน บูธขายของในห้าง Pop-up Store กรุงเทพฯ"
  description="ติดต่อ TNC Build Studio รับใบเสนอราคาฟรี รับเหมาตกแต่งภายใน ทำบูธขายของในห้าง Pop-up Store ตกแต่งร้านค้า กรุงเทพ | Contact for a free quote, Bangkok Thailand"
  bodyClass="v6">
  <Header active="contact" overlay />
  <main class="c-page">
    <div class="c-split">
      {photo && (
        <figure class="c-photo">
          <img src={cld(photo.src, { w: 1600, h: 2000 })} srcset={cldSet(photo.src, [600, 1000, 1600, 2000], 4 / 5)} sizes="(min-width: 900px) 50vw, 100vw" alt={photo.p ? nameOf(photo.p) : ''} fetchpriority="high" />
          {photo.p && <figcaption class="c-cap"><a href={projectUrl(photo.p)}>{nameOf(photo.p)}{placeOf(photo.p) && `, ${placeOf(photo.p)}`}</a></figcaption>}
        </figure>
      )}

      <section class="c-info" aria-labelledby="c-title">
        <div class="c-in">
          <h1 class="c-title c-rv" id="c-title">Contact</h1>
          <p class="c-intro c-rv" style={delay(0)}>{intro}</p>
          <dl class="c-dl">
            <div class="c-rv" style={delay(1)}><dt>LINE</dt><dd><a href={site.lineUrl} rel="noopener">{site.lineId}</a></dd></div>
            <div class="c-rv" style={delay(2)}><dt>Phone</dt><dd class="c-stack"><a class="t-num" href={site.phoneHref}>{site.phoneDisplay}</a><a class="c-sub t-num" href={site.officeHref}>Office {site.officeDisplay}</a></dd></div>
            {email && <div class="c-rv" style={delay(3)}><dt>Email</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>}
            <div class="c-rv" style={delay(4)}><dt>Hours</dt><dd>{site.hours}</dd></div>
            <div class="c-rv" style={delay(5)}><dt>Studio</dt><dd class="c-stack" lang="th">{site.address.lines.map((l) => <span>{l}</span>)}</dd></div>
            {socials.length > 0 && <div class="c-rv" style={delay(6)}><dt>Follow</dt><dd class="c-follow">{socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</dd></div>}
          </dl>
          <div class="c-btns c-rv" style={delay(7)}>
            <a class="t-btn t-btn--line" href={site.lineUrl} rel="noopener">Chat on LINE</a>
            <a class="t-btn t-btn--ghost" href={site.phoneHref}>Call the studio</a>
          </div>
        </div>
      </section>
    </div>
  </main>
  <Footer compact />
  <script is:inline>
    (function () {
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('c-js');
      requestAnimationFrame(function () { requestAnimationFrame(function () {
        document.querySelectorAll('.c-rv').forEach(function (el) { el.classList.add('is-in'); });
      }); });
    })();
  </script>
</Layout>

<style>
  /* Full-bleed photo on the left half, calm details on the right half */
  .c-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: calc(100svh - 68px); }
  .c-photo { position: relative; margin: 0; background: var(--tile); overflow: hidden; }
  .c-photo::after { content: ""; position: absolute; inset: 0 0 auto; height: 160px; background: linear-gradient(180deg, rgba(8,22,56,.45), rgba(8,22,56,0)); pointer-events: none; }
  .c-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .c-cap { position: absolute; left: var(--m); right: var(--m); bottom: 24px; z-index: 1; font-size: 12px; line-height: 1.4; }
  .c-cap a { color: rgba(255,255,255,.85); text-shadow: 0 1px 10px rgba(0,0,0,.5); }
  .c-cap a:hover { color: #fff; }

  .c-info { display: flex; align-items: center; padding: clamp(100px, 13svh, 136px) var(--m) clamp(40px, 5svh, 72px) clamp(40px, 6vw, 112px); }
  .c-in { width: 100%; max-width: 520px; }
  .c-title { margin: 0; font-size: clamp(36px, 3.6vw, 56px); line-height: 1; font-weight: 800; letter-spacing: -.04em; text-transform: uppercase; }
  .c-intro { margin: 20px 0 0; max-width: 34ch; font-size: 16px; line-height: 1.6; color: var(--mute); }

  .c-dl { margin: clamp(40px, 4vw, 56px) 0 0; display: grid; }
  .c-dl > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 16px; align-items: baseline; padding-block: 14px; border-top: 1px solid rgba(255,255,255,.08); font-size: 15px; line-height: 1.55; }
  .c-dl > div:last-child { border-bottom: 1px solid rgba(255,255,255,.08); }
  .c-dl dt { font-size: 13px; color: var(--mute); }
  .c-dl dd { margin: 0; min-width: 0; overflow-wrap: anywhere; color: var(--soft); }
  .c-dl a { color: #fff; display: inline-block; padding-block: 12px; margin-block: -12px; transition: color .3s; }
  .c-dl a:hover { color: var(--soft); }
  .c-stack { display: grid; gap: 2px; justify-items: start; }
  .c-stack .c-sub { color: var(--mute); font-size: 14px; }
  .c-follow { display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .c-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  /* Subtle motion */
  :global(html.c-js) .c-rv { opacity: 0; transform: translateY(12px); transition: opacity 1.2s cubic-bezier(.16,1,.3,1) var(--d, 0s), transform 1.2s cubic-bezier(.16,1,.3,1) var(--d, 0s); }
  :global(html.c-js) .c-rv.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .c-photo img { animation: c-settle 3s cubic-bezier(.16,1,.3,1) both; }
  }
  @keyframes c-settle { from { transform: scale(1.06); } to { transform: none; } }

  @media (max-width: 899px) {
    .c-split { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .c-photo { aspect-ratio: 4 / 5; max-height: 72svh; }
    .c-info { padding: 40px var(--m) 56px; }
    .c-in { max-width: none; }
  }
  @media (max-width: 420px) {
    .c-dl > div { grid-template-columns: 76px minmax(0, 1fr); }
    .c-btns .t-btn { flex: 1 1 100%; justify-content: center; }
  }
</style>
