---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/v6/Header.astro';
import Footer from '../../components/v6/Footer.astro';
import PageHead from '../../components/v6/PageHead.astro';
import { getCollection } from 'astro:content';
import { cld, cldSet } from '../../lib/cld';

// Pair English and Thai articles by same date + category; unpaired ones stand alone
const all = (await getCollection('specbook')).filter((p: any) => !p.data.draft);
const isTh = (p: any) => p.data.lang === 'th' || p.id.startsWith('th-');
const key = (p: any) => `${String(p.data.date).slice(0, 10)}|${p.data.category || ''}`;
const thByKey = new Map<string, any>();
all.filter(isTh).forEach((p: any) => { if (!thByKey.has(key(p))) thByKey.set(key(p), p); });
const items: any[] = all.filter((p: any) => !isTh(p)).map((p: any) => ({ en: p, th: thByKey.get(key(p)) }));
const pairedTh = new Set(items.map((i) => i.th).filter(Boolean));
all.filter(isTh).forEach((p: any) => { if (!pairedTh.has(p)) items.push({ en: null, th: p }); });
items.forEach((i) => {
  i.main = i.en || i.th;
  i.href = `/specbook/${i.main.id}`;
  i.thHref = i.en && i.th ? `/specbook/${i.th.id}` : '';
  i.cover = String(i.main.data.cover || i.th?.data.cover || '').trim();
  i.date = new Date(i.main.data.date);
});
items.sort((a, b) => b.date.getTime() - a.date.getTime());
const fmt = (d: Date) => isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const lead = items[0];
const rest = items.slice(1);
const delay = (i: number, step = 0.06) => `--d:${(Math.min(i, 5) * step).toFixed(2)}s`;
---
<Layout
  title="Specbook — บทความออกแบบตกแต่งภายใน บูธ Pop-up Store กรุงเทพฯ"
  description="บทความและข้อมูลด้านการออกแบบตกแต่งภายใน บูธขายของในห้าง Pop-up Store ตกแต่งร้านค้า และรับเหมาตกแต่งภายในกรุงเทพ | Guides and project notes from TNC Build Studio, Bangkok."
  bodyClass="v6">
  <Header active="specbook" />
  <main class="b-page">
    <PageHead title="Specbook" aside="Guides and project notes from the studio, in English and Thai." />

    <section class="b-paper">
      <div class="t-wrap b-block">
        {lead ? (
          <>
            <div class="b-group">
              <div class="b-head b-rv"><h2>Latest</h2></div>
              <article class="b-lead b-rv">
                <div class="b-lead-img">
                  {lead.cover && <img src={cld(lead.cover, { w: 1600, h: 1000 })} srcset={cldSet(lead.cover, [800, 1200, 1600], 16 / 10)} sizes="(min-width: 768px) 58vw, 100vw" alt="" decoding="async" />}
                </div>
                <div class="b-lead-text">
                  <span class="b-meta">{[lead.main.data.category, fmt(lead.date)].filter(Boolean).join(' · ')}</span>
                  <h3 class="b-en" lang={lead.en ? 'en' : 'th'}><a class="b-en-link" href={lead.href}>{lead.main.data.title}</a></h3>
                  {lead.thHref && <a class="b-th" lang="th" href={lead.thHref}>{lead.th.data.title}</a>}
                  <span class="b-more" aria-hidden="true">{lead.en ? 'Read the guide' : 'อ่านบทความ'}</span>
                </div>
              </article>
            </div>

            {rest.length > 0 && (
              <div class="b-group">
                <div class="b-head b-rv"><h2>All articles</h2><p class="t-num">{items.length} articles</p></div>
                <ol class="b-list">
                  {rest.map((it, i) => (
                    <li class="b-row b-rv" style={delay(i)}>
                      <div class="b-thumb">
                        {it.cover && <img src={cld(it.cover, { w: 480, h: 360 })} srcset={cldSet(it.cover, [240, 480], 4 / 3)} sizes="160px" alt="" loading="lazy" decoding="async" />}
                      </div>
                      <span class="b-cat">{it.main.data.category}</span>
                      <span class="b-titles">
                        <a class="b-en b-en-link" lang={it.en ? 'en' : 'th'} href={it.href}>{it.main.data.title}</a>
                        {it.thHref && <a class="b-th" lang="th" href={it.thHref}>{it.th.data.title}</a>}
                      </span>
                      <span class="b-date t-num">{fmt(it.date)}</span>
                    </li>
                  ))}
                </ol>
              </div>
            )}
          </>
        ) : (
          <p class="b-empty">No articles yet. Add them in the CMS under News &amp; Articles.</p>
        )}
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.b-rv');
      if (!els.length || !('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('b-js');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
</Layout>

<style>
  .b-page { --b-rule: #D6D4CC; }
  .b-paper { background: var(--paper); color: var(--blue); }
  .b-block { padding-block: clamp(64px, 7vw, 112px); }
  .b-group + .b-group { margin-top: clamp(72px, 7vw, 112px); }

  /* Same section heading as Studio */
  .b-head { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px var(--gap); align-items: baseline; padding-bottom: 24px; border-bottom: 1px solid var(--blue); }
  .b-head h2 { margin: 0; font-size: clamp(24px, 2.2vw, 32px); line-height: 1.15; font-weight: 400; letter-spacing: -.02em; }
  .b-head p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--grey); }

  .b-en-link { color: inherit; }
  .b-en-link::after { content: ""; position: absolute; inset: 0; }
  .b-th { position: relative; z-index: 1; display: inline-block; padding-block: 11px; margin-block: -11px; color: var(--grey); }
  .b-th:hover { color: var(--blue); }
  .b-lead:hover .b-en-link, .b-row:hover .b-en-link { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }

  /* Latest */
  .b-lead { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px var(--gap); align-items: end; padding-top: 32px; }
  .b-lead-img { aspect-ratio: 16 / 10; overflow: hidden; background: #E2E0D8; }
  .b-lead-img img, .b-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.16,1,.3,1); }
  .b-lead:hover .b-lead-img img { transform: scale(1.03); }
  .b-lead-text { display: grid; gap: 12px; justify-items: start; }
  .b-meta { font-size: 13px; color: var(--grey); }
  .b-lead .b-en { margin: 0; font-size: clamp(24px, 2.4vw, 36px); font-weight: 500; line-height: 1.2; letter-spacing: -.02em; }
  .b-lead .b-th { font-size: 17px; line-height: 1.5; }
  .b-more { margin-top: 8px; font-size: 14px; font-weight: 500; border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  /* All articles */
  .b-list { margin: 0; padding: 0; list-style: none; }
  .b-row { position: relative; display: grid; grid-template-columns: 160px 140px minmax(0, 1fr) auto; grid-template-areas: "thumb cat titles date"; gap: 16px var(--gap); align-items: center; padding-block: 24px; border-bottom: 1px solid var(--b-rule); }
  .b-thumb { grid-area: thumb; aspect-ratio: 4 / 3; overflow: hidden; background: #E2E0D8; }
  .b-row:hover .b-thumb img { transform: scale(1.04); }
  .b-cat { grid-area: cat; font-size: 13px; color: var(--grey); }
  .b-titles { grid-area: titles; display: grid; gap: 4px; justify-items: start; }
  .b-row .b-en { font-size: 20px; font-weight: 500; line-height: 1.3; letter-spacing: -.01em; }
  .b-row .b-th { font-size: 15px; line-height: 1.5; }
  .b-date { grid-area: date; font-size: 13px; color: var(--grey); white-space: nowrap; }
  .b-empty { margin: 0; font-size: 15px; color: var(--grey); }

  /* Subtle motion, same as Studio */
  :global(html.b-js) .b-rv { opacity: 0; transform: translateY(18px); transition: opacity 1.1s cubic-bezier(.16,1,.3,1) var(--d, 0s), transform 1.1s cubic-bezier(.16,1,.3,1) var(--d, 0s); }
  :global(html.b-js) .b-rv.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .b-page :global(.t-pagehead-main), .b-page :global(.t-pagehead-aside) { animation: b-rise 1.1s cubic-bezier(.16,1,.3,1) both; }
    .b-page :global(.t-pagehead-aside) { animation-delay: .15s; }
  }
  @media (prefers-reduced-motion: reduce) { .b-lead-img img, .b-thumb img { transition: none; } }
  @keyframes b-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1023px) {
    .b-row { grid-template-columns: 140px 110px minmax(0, 1fr) auto; }
  }
  @media (max-width: 767px) {
    .b-head, .b-lead { grid-template-columns: minmax(0, 1fr); }
    .b-lead { gap: 20px; padding-top: 24px; }
    .b-row { grid-template-columns: 96px minmax(0, 1fr); grid-template-areas: "thumb cat" "thumb titles" "thumb date"; align-items: start; gap: 6px 16px; padding-block: 20px; }
    .b-row .b-en { font-size: 17px; }
  }
</style>
