---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/v6/Header.astro';
import Footer from '../../components/v6/Footer.astro';
import { cld, cldSet } from '../../lib/cld';
import fs from 'node:fs';
import path from 'node:path';
import matter from 'gray-matter';

export async function getStaticPaths() {
  const dir = path.join(process.cwd(), 'src/content/specbook');
  const files = fs.readdirSync(dir).filter(f => f.endsWith('.md'));
  return files.map(filename => ({
    params: { slug: filename.replace('.md', '') },
    props: { filename }
  }));
}

const { filename } = Astro.props;
const { slug } = Astro.params;
const dir = path.join(process.cwd(), 'src/content/specbook');
const raw = fs.readFileSync(path.join(dir, `${filename}`), 'utf8');
const { data: d, content: body } = matter(raw);

const seoTitle = d.seo_title || d.title;
const seoDescription = d.seo_description || d.excerpt || `${d.title} — TNC.18 Bangkok`;
const canonical = `https://tncbuildstudio.com/specbook/${encodeURIComponent(String(slug))}`;
const publishDate = new Date(d.date).toISOString();
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": seoTitle,
  "description": seoDescription,
  "datePublished": publishDate,
  "author": { "@type": "Organization", "name": "TNC.18" }
});

// Convert markdown to HTML
function mdToHtml(md) {
  let out = md
    .replace(/^### (.+)$/gm, '<h3>$1</h3>')
    .replace(/^## (.+)$/gm, '<h2>$1</h2>')
    .replace(/^# (.+)$/gm, '<h1>$1</h1>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/^- (.+)$/gm, '<li>$1</li>')
    .replace(/^---$/gm, '<hr>');
  out = out.replace(/(<li>[\s\S]*?<\/li>)(\n<li>[\s\S]*?<\/li>)*/g, (m) => `<ul>${m}</ul>`);
  return out.split(/\n\n+/).map(block => {
    const b = block.trim();
    if (!b) return '';
    if (/^<(h[1-6]|ul|hr)/.test(b)) return b;
    return `<p>${b.replace(/\n/g, ' ')}</p>`;
  }).join('\n');
}
const htmlBody = mdToHtml(body);

// Other-language version (same date + category) and more articles in this language
const ds = (v: any) => v instanceof Date ? v.toISOString().slice(0, 10) : String(v || '').slice(0, 10);
const isThai = d.lang === 'th' || String(slug).startsWith('th-');
const pool = fs.readdirSync(dir).filter((f) => f.endsWith('.md') && f !== filename).map((f) => {
  const m: any = matter(fs.readFileSync(path.join(dir, f), 'utf8')).data;
  return { slug: f.replace('.md', ''), m, th: m.lang === 'th' || f.startsWith('th-') };
}).filter((x) => !x.m.draft);
const keyOf = (m: any) => `${ds(m.date)}|${m.category || ''}`;
const other = pool.find((x) => x.th !== isThai && keyOf(x.m) === keyOf(d));
const more = pool.filter((x) => x.th === isThai)
  .sort((a, b) => ds(b.m.date).localeCompare(ds(a.m.date)))
  .slice(0, 3);
const fmt = (v: any) => {
  const t = new Date(ds(v));
  return isNaN(t.getTime()) ? '' : t.toLocaleDateString(isThai ? 'th-TH' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
};
const cover = String(d.cover || '').trim();
const delay = (i: number) => `--d:${(i * 0.08).toFixed(2)}s`;
---
<Layout title={seoTitle} description={seoDescription} bodyClass="v6">
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <link rel="canonical" href={canonical} slot="head" />
  <Header active="specbook" />
  <main class="a-page" lang={isThai ? 'th' : 'en'}>
    <section class="t-wrap a-head">
      <nav class="a-crumb" aria-label="Breadcrumb">
        <a href="/specbook">Specbook</a>
        {d.category && <><span aria-hidden="true">/</span><span>{d.category}</span></>}
      </nav>
      <h1 class="a-title">{d.title}</h1>
      <div class="a-sub">
        <span class="a-meta t-num">{[fmt(d.date), d.author].filter(Boolean).join(' · ')}</span>
        {other && (
          <a class="t-link a-lang" href={`/specbook/${other.slug}`} lang={isThai ? 'en' : 'th'}>
            {isThai ? 'Read in English' : 'อ่านภาษาไทย'} <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </section>

    {cover && (
      <figure class="a-cover">
        <img src={cld(cover, { w: 2400, h: 1200 })} srcset={cldSet(cover, [800, 1600, 2400], 2)} sizes="100vw" alt="" fetchpriority="high" />
      </figure>
    )}

    <section class="a-paper">
      <div class="t-wrap a-body">
        <aside class="a-side">
          {d.excerpt && <p class="a-lead a-rv">{d.excerpt}</p>}
        </aside>
        <div class:list={["a-prose", "a-rv", { "a-prose--th": isThai }]} style="--d:.1s" set:html={htmlBody} />
      </div>
    </section>

    {more.length > 0 && (
      <section class="t-wrap a-more" aria-labelledby="a-more-h">
        <div class="a-mhead a-rv">
          <h2 id="a-more-h">{isThai ? 'บทความอื่นใน Specbook' : 'More from the Specbook'}</h2>
          <a class="t-link" href="/specbook">{isThai ? 'บทความทั้งหมด' : 'All articles'} <span aria-hidden="true">→</span></a>
        </div>
        <ol class="a-list">
          {more.map((x, i) => (
            <li class="a-row a-rv" style={delay(i)}>
              <div class="a-thumb">
                {x.m.cover && <img src={cld(String(x.m.cover).trim(), { w: 480, h: 360 })} srcset={cldSet(String(x.m.cover).trim(), [240, 480], 4 / 3)} sizes="160px" alt="" loading="lazy" decoding="async" />}
              </div>
              <span class="a-rcat">{x.m.category}</span>
              <a class="a-rt" href={`/specbook/${x.slug}`}>{x.m.title}</a>
              <span class="a-rdate t-num">{fmt(x.m.date)}</span>
            </li>
          ))}
        </ol>
      </section>
    )}
  </main>
  <Footer />
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.a-rv');
      if (!els.length || !('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('a-js');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.02 });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
</Layout>

<style>
  .a-page { --a-rule: #D6D4CC; --a-ink: #333B4F; }

  /* Head */
  .a-head { padding-block: clamp(120px, 12vw, 176px) clamp(40px, 5vw, 64px); }
  .a-crumb { display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; color: var(--mute); margin-bottom: 20px; }
  .a-crumb a { color: var(--mute); display: inline-block; padding-block: 12px; margin-block: -12px; }
  .a-crumb a:hover { color: #fff; }
  .a-title { margin: 0; max-width: 22ch; font-size: clamp(32px, 4.2vw, 64px); line-height: 1.1; font-weight: 500; letter-spacing: -.03em; }
  .a-page[lang="th"] .a-title { line-height: 1.35; letter-spacing: 0; max-width: 28ch; }
  .a-sub { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; justify-content: space-between; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--line); }
  .a-meta { font-size: 14px; color: var(--mute); }
  .a-lang { display: inline-block; padding-block: 12px; margin-block: -12px; }

  .a-cover { margin: 0; background: var(--tile); overflow: hidden; }
  .a-cover img { display: block; width: 100%; aspect-ratio: 2 / 1; max-height: 640px; object-fit: cover; }

  /* Reading */
  .a-paper { background: var(--paper); color: var(--blue); }
  .a-body { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px var(--gap); padding-block: clamp(64px, 7vw, 112px); }
  .a-side { align-self: start; position: sticky; top: 32px; }
  :global(body:has(.t-header.is-stuck)) .a-side { top: 108px; }
  .a-lead { margin: 0; max-width: 26ch; font-size: clamp(20px, 1.8vw, 26px); line-height: 1.4; font-weight: 300; letter-spacing: -.01em; }
  .a-page[lang="th"] .a-lead { line-height: 1.7; letter-spacing: 0; max-width: 32ch; }

  .a-prose { max-width: 68ch; font-size: 17px; line-height: 1.75; color: var(--a-ink); }
  .a-prose :global(> :first-child) { margin-top: 0; }
  .a-prose :global(h1), .a-prose :global(h2) { margin: 56px 0 16px; font-size: clamp(22px, 2vw, 28px); line-height: 1.25; font-weight: 500; letter-spacing: -.015em; color: var(--blue); }
  .a-prose :global(h3) { margin: 36px 0 10px; font-size: 19px; line-height: 1.35; font-weight: 500; color: var(--blue); }
  .a-prose :global(p) { margin: 0 0 20px; }
  .a-prose :global(strong) { font-weight: 600; color: var(--blue); }
  .a-prose :global(a) { color: var(--blue); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .a-prose :global(a:hover) { color: var(--grey); }
  .a-prose :global(ul) { margin: 0 0 24px; padding-left: 1.25em; list-style: disc; }
  .a-prose :global(li) { margin: 0 0 8px; padding-left: 4px; }
  .a-prose :global(li::marker) { color: var(--grey); }
  .a-prose :global(hr) { border: 0; border-top: 1px solid var(--a-rule); margin: 48px 0; }
  .a-prose :global(table) { width: 100%; border-collapse: collapse; margin: 32px 0; font-size: 15px; display: block; overflow-x: auto; }
  .a-prose :global(td), .a-prose :global(th) { padding: 12px 16px 12px 0; border-bottom: 1px solid var(--a-rule); text-align: left; vertical-align: top; }
  .a-prose :global(tr:first-child td), .a-prose :global(th) { font-weight: 500; color: var(--blue); border-bottom-color: var(--blue); }
  .a-prose--th { line-height: 1.95; letter-spacing: 0; }
  .a-prose--th :global(h1), .a-prose--th :global(h2), .a-prose--th :global(h3) { line-height: 1.55; letter-spacing: 0; }

  /* More */
  .a-more { padding-block: clamp(64px, 7vw, 112px); }
  .a-mhead { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; justify-content: space-between; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,.35); }
  .a-mhead h2 { margin: 0; font-size: clamp(24px, 2.2vw, 32px); line-height: 1.15; font-weight: 400; letter-spacing: -.02em; }
  .a-mhead .t-link { display: inline-block; padding-block: 12px; margin-block: -12px; }
  .a-list { margin: 0; padding: 0; list-style: none; }
  .a-row { position: relative; display: grid; grid-template-columns: 160px 140px minmax(0, 1fr) auto; grid-template-areas: "thumb cat title date"; gap: 16px var(--gap); align-items: center; padding-block: 24px; border-bottom: 1px solid var(--line); }
  .a-thumb { grid-area: thumb; aspect-ratio: 4 / 3; overflow: hidden; background: var(--tile); }
  .a-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.16,1,.3,1); }
  .a-row:hover .a-thumb img { transform: scale(1.04); }
  .a-rcat { grid-area: cat; font-size: 13px; color: var(--mute); }
  .a-rt { grid-area: title; font-size: 20px; font-weight: 500; line-height: 1.3; letter-spacing: -.01em; color: #fff; }
  .a-rt::after { content: ""; position: absolute; inset: 0; }
  .a-row:hover .a-rt { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .a-rdate { grid-area: date; font-size: 13px; color: var(--mute); white-space: nowrap; }

  /* Subtle motion */
  :global(html.a-js) .a-rv { opacity: 0; transform: translateY(18px); transition: opacity 1.1s cubic-bezier(.16,1,.3,1) var(--d, 0s), transform 1.1s cubic-bezier(.16,1,.3,1) var(--d, 0s); }
  :global(html.a-js) .a-rv.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    .a-head { animation: a-rise 1.1s cubic-bezier(.16,1,.3,1) both; }
    .a-cover img { animation: a-settle 2.8s cubic-bezier(.16,1,.3,1) both; }
  }
  @media (prefers-reduced-motion: reduce) { .a-thumb img { transition: none; } }
  @keyframes a-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes a-settle { from { transform: scale(1.05); } to { transform: none; } }

  @media (max-width: 1023px) {
    .a-body { grid-template-columns: minmax(0, 1fr); }
    .a-side { position: static; }
    .a-lead { max-width: 34ch; }
    .a-row { grid-template-columns: 140px 110px minmax(0, 1fr) auto; }
  }
  @media (max-width: 767px) {
    .a-cover img { aspect-ratio: 4 / 3; }
    .a-prose { font-size: 16px; }
    .a-row { grid-template-columns: 96px minmax(0, 1fr); grid-template-areas: "thumb cat" "thumb title" "thumb date"; align-items: start; gap: 6px 16px; padding-block: 20px; }
    .a-rt { font-size: 17px; }
  }
</style>
