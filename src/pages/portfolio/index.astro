---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/v6/Header.astro";
import Footer from "../../components/v6/Footer.astro";
import PageHead from "../../components/v6/PageHead.astro";
import ProjectCard from "../../components/v6/ProjectCard.astro";
import { getProjects, projectUrl, projectName, projectMeta } from "../../lib/projects";

const projects = await getProjects();
const years = projects.map((p: any) => Number(p.data.year)).filter(Boolean);
const yearMin = Math.min(...years), yearMax = Math.max(...years);
const span = yearMin === yearMax ? String(yearMax) : `${yearMin}–${yearMax}`;

// Types, most projects first (same order as Home)
const counts = new Map<string, number>();
for (const p of projects) {
  const c = String(p.data.category ?? "").trim();
  if (c) counts.set(c, (counts.get(c) ?? 0) + 1);
}
const cats = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => ({ name, count }));
---
<Layout title="ผลงาน — รับเหมาตกแต่งร้านค้า บูธขายของในห้าง Pop-up Store" description="ผลงานการออกแบบและสร้างบูธขายของในห้าง Pop-up Store ตกแต่งร้านค้า และตกแต่งภายในโดย TNC Build Studio กรุงเทพ | Portfolio of retail booth design and interior fit-out Bangkok" bodyClass="v6">
  <Header active="work" />
  <main>
    <PageHead title="Work" aside={`${projects.length} projects, ${span}. Shops, pop-ups, exhibition pavilions, clinics and homes across Bangkok.`} />

    <div class="w-filter" data-filter>
      <div class="t-wrap">
        <div class="w-tabs" role="group" aria-label="Filter by type">
          <button type="button" class="w-tab" data-tab="all" aria-pressed="true">All <span class="w-count t-num">{projects.length}</span></button>
          {cats.map((c) => (
            <button type="button" class="w-tab" data-tab={c.name} aria-pressed="false">{c.name} <span class="w-count t-num">{c.count}</span></button>
          ))}
        </div>
      </div>
    </div>

    <section class="t-wrap w-grid-wrap" aria-label="Projects" data-grid>
      <ul class="w-grid">
        {projects.map((p: any, i: number) => (
          <li data-cat={String(p.data.category ?? "").trim()}>
            <ProjectCard href={projectUrl(p)} title={projectName(p)} meta={projectMeta(p)} img={p.data.cover} ratio="4/5"
              sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 25vw" eager={i < 4} />
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const bar = document.querySelector<HTMLElement>("[data-filter]");
  const grid = document.querySelector<HTMLElement>("[data-grid]");
  if (bar && grid) {
    const tabs = [...bar.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const items = [...grid.querySelectorAll<HTMLElement>("li[data-cat]")];
    const pick = (cat: string, fromClick: boolean) => {
      const t = tabs.find((x) => x.dataset.tab === cat) ?? tabs[0];
      const name = t.dataset.tab || "all";
      tabs.forEach((x) => x.setAttribute("aria-pressed", String(x === t)));
      items.forEach((li) => { li.hidden = !(name === "all" || li.dataset.cat === name); });
      if (!fromClick) { t.scrollIntoView({ block: "nearest", inline: "center" }); return; }
      const url = new URL(location.href);
      if (name === "all") url.searchParams.delete("type"); else url.searchParams.set("type", name);
      history.replaceState(null, "", url);
      // If the bar is stuck at the top, bring the start of the grid back into view
      const top = grid.getBoundingClientRect().top + scrollY - bar.offsetHeight - 8;
      if (scrollY > top) scrollTo({ top });
    };
    tabs.forEach((t) => t.addEventListener("click", () => pick(t.dataset.tab || "all", true)));
    const q = new URLSearchParams(location.search).get("type");
    if (q) pick(q, false);
  }
</script>

<style>
  .w-filter { position: sticky; top: 0; z-index: 5; background: var(--blue); transition: top .3s ease; }
  body:has(.t-header.is-stuck) .w-filter { top: 76px; }
  .w-tabs { display: flex; gap: 0 28px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .w-tabs::-webkit-scrollbar { display: none; }
  .w-tab { flex: 0 0 auto; height: 56px; margin-bottom: -1px; padding: 0; background: none; border: 0; border-bottom: 2px solid transparent; color: var(--mute); font: 400 14px var(--f); white-space: nowrap; cursor: pointer; transition: color .3s ease, border-color .3s ease; }
  .w-tab:hover, .w-tab[aria-pressed="true"] { color: #fff; }
  .w-tab[aria-pressed="true"] { border-bottom-color: #fff; }
  .w-count { margin-left: 4px; font-size: 12px; color: var(--mute); }
  .w-grid-wrap { padding-top: 40px; padding-bottom: var(--sec); }
  .w-grid { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 48px 24px; }
  .w-grid li[hidden] { display: none; }
  @media (max-width: 1100px) { .w-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .w-tabs { gap: 0 22px; margin-inline: calc(var(--m) * -1); padding-inline: var(--m); }
    .w-grid-wrap { padding-top: 28px; }
    .w-grid { grid-template-columns: 1fr; gap: 36px; }
  }
</style>
