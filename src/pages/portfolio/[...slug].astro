---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/v6/Header.astro";
import Footer from "../../components/v6/Footer.astro";
import PageHead from "../../components/v6/PageHead.astro";
import { render } from "astro:content";
import { cld, cldSet } from "../../lib/cld";
import { getProjects, projectSlug, projectUrl, projectName, projectMeta, byNewest } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p: any) => ({ params: { slug: projectSlug(String(p.data.title)) }, props: { project: p } }));
}

const { project } = Astro.props as any;
const d = project.data;
const { Content } = await render(project);
const hasBody = String(project.body ?? "").trim().length > 0;

const name = projectName(project);
const sub = String(d.title).split(/\s+[—–-]\s+/).slice(1).join(" — ").trim();
const cat = String(d.category ?? "").trim();
const size = String(d.size ?? "").trim();
const area = d.area ? `${d.area} m²` : size ? (/^\d+(\.\d+)?$/.test(size) ? `${size} m²` : size) : "";
const facts = [
  { k: "Client", v: String(d.client ?? "").trim() },
  { k: "Location", v: String(d.location ?? "").split(",")[0].trim() },
  { k: "Year", v: d.year ? String(d.year) : "" },
  { k: "Area", v: area },
].filter((x) => x.v);

// Gallery without the cover (and without repeats)
const key = (u: string) => String(u).trim().split("/").pop() || "";
const cover = String(d.cover ?? "").trim();
const seen = new Set<string>(cover ? [key(cover)] : []);
const photos: string[] = (d.gallery ?? []).map((u: string) => String(u).trim()).filter((u: string) => {
  const k = key(u);
  if (!u || seen.has(k)) return false;
  seen.add(k);
  return true;
});
const hero = cover || photos.shift() || "";

// Rhythm: two tall, one wide, three tall, repeat; the last group is evened out
const pattern = [["half", "half"], ["full"], ["third", "third", "third"]];
const kinds: string[] = [];
for (let i = 0, g = 0; i < photos.length; g++) {
  const grp = pattern[g % 3];
  const n = Math.min(grp.length, photos.length - i);
  if (n === grp.length) kinds.push(...grp);
  else if (n === 1) kinds.push("full");
  else kinds.push("half", "half");
  i += n;
}
const FIRST = 6;

// Next project, in the same order as the Work page
const all = byNewest(await getProjects());
const idx = all.findIndex((p: any) => p.id === project.id);
const next = all.length > 1 ? all[(idx + 1) % all.length] : null;
---
<Layout bodyClass="v6" title={`${d.title}`} description={d.description || `${d.title} — Retail & Interior Design by TNC BUILD STUDIO Bangkok`}>
  <Header active="work" />
  <main class="p-page">
    <PageHead title={name}>
      <nav class="t-crumb" slot="crumb" aria-label="Breadcrumb"><a href="/portfolio">Work</a>{cat && <> / <a href={`/portfolio?type=${encodeURIComponent(cat)}`}>{cat}</a></>}</nav>
      <p class="p-sub" slot="sub">{sub}</p>
      <dl class="p-facts" slot="aside">{facts.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}</dl>
    </PageHead>

    {(d.video_url || hero) && (
      <div class="p-cover">
        {d.video_url
          ? <video class="p-cover-media" autoplay muted loop playsinline poster={hero ? cld(hero, { w: 1800 }) : undefined} data-video><source src={d.video_url} type="video/mp4" /></video>
          : <picture>
              <source media="(max-width: 600px)" srcset={cldSet(hero, [600, 900, 1200], 4 / 3)} sizes="100vw" />
              <img class="p-cover-media" src={cld(hero, { w: 2400, h: 1100 })} srcset={cldSet(hero, [1200, 1800, 2400], 24 / 11)} sizes="100vw" alt={d.title} loading="eager" fetchpriority="high" decoding="async" />
            </picture>}
      </div>
    )}

    {(d.description || hasBody) && (
      <section class="t-paper p-story" aria-label="About the project">
        <div class="t-wrap p-story-in">
          {d.description && <p class="t-lead p-lead">{d.description}</p>}
          {hasBody && <div class="p-body"><Content /></div>}
        </div>
      </section>
    )}

    <script is:inline>if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("p-js");</script>
    {photos.length > 0 && (
      <section class="p-gallery" aria-label="Photos" data-gallery>
        <ul class="p-grid">
          {photos.map((u, i) => {
            const k = kinds[i];
            const r = k === "full" ? 16 / 9 : 4 / 5;
            const ws = k === "full" ? [1200, 1800, 2400] : [600, 900, 1200, 1600];
            const sz = k === "full" ? "100vw" : k === "half" ? "(max-width: 600px) 100vw, 50vw" : "(max-width: 600px) 100vw, 33vw";
            return (
              <li class={`p-ph p-ph--${k}`}>
                <img src={cld(u, { w: ws[1], h: Math.round(ws[1] / r) })} srcset={cldSet(u, ws, r)} sizes={sz} alt={`${name}, photo ${i + 1}`} loading="lazy" decoding="async" />
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {next && (
      <section class="t-wrap p-next m-rv" aria-labelledby="p-next">
        <div class="p-next-head">
          <h2 id="p-next" class="p-next-label">Next project</h2>
          <a class="t-link" href="/portfolio">All work <span aria-hidden="true">→</span></a>
        </div>
        <a class="p-next-a" href={projectUrl(next)}>
          <span class="p-next-ph">{next.data.cover && <img src={cld(next.data.cover, { w: 900, h: 675 })} srcset={cldSet(next.data.cover, [480, 900, 1200], 4 / 3)} sizes="(max-width: 600px) 100vw, 420px" alt="" loading="lazy" decoding="async" />}</span>
          <span class="p-next-txt">
            <span class="p-next-name">{projectName(next)}</span>
            <span class="t-meta">{projectMeta(next)}</span>
          </span>
        </a>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<script>
  // Gallery photos fade in as they come into view
  const imgs = [...document.querySelectorAll<HTMLImageElement>(".p-ph img")];
  const reveal = (im: HTMLImageElement) => im.classList.add("is-in");
  if (!document.documentElement.classList.contains("p-js") || !("IntersectionObserver" in window)) {
    imgs.forEach(reveal);
  } else {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const im = e.target as HTMLImageElement;
      io.unobserve(im);
      if (im.complete && im.naturalWidth) reveal(im);
      else { im.addEventListener("load", () => reveal(im), { once: true }); im.addEventListener("error", () => reveal(im), { once: true }); }
    }), { rootMargin: "0px 0px -6% 0px" });
    imgs.forEach((im) => io.observe(im));
  }
  const vid = document.querySelector<HTMLVideoElement>("[data-video]");
  if (vid && matchMedia("(prefers-reduced-motion: reduce)").matches) { vid.removeAttribute("autoplay"); vid.pause(); vid.controls = true; }
</script>

<style is:global>
  .p-page .t-pagehead .t-display { font-size: clamp(40px, 5.6vw, 88px); overflow-wrap: anywhere; }
  .p-page .t-crumb a { color: var(--mute); }
  .p-page .t-crumb a:hover { color: #fff; }
  .p-page .p-sub { margin: 16px 0 0; font-size: clamp(17px, 1.5vw, 22px); font-weight: 300; letter-spacing: -.01em; color: var(--soft); }
  .p-page .p-sub:empty, .p-page .p-facts:empty { display: none; }
  .p-page .p-facts { margin: 0; flex: 0 1 480px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 24px; }
  .p-page .p-facts dt { font-size: 13px; color: var(--mute); }
  .p-page .p-facts dd { margin: 4px 0 0; font-size: 15px; font-weight: 400; }
  .p-page .p-cover { position: relative; height: clamp(360px, 50vw, 760px); overflow: hidden; background: var(--tile); }
  .p-page .p-cover picture, .p-page .p-cover-media { display: block; width: 100%; height: 100%; }
  .p-page .p-cover-media { object-fit: cover; }
  .p-page .p-story-in { padding-block: var(--sec); display: flex; flex-wrap: wrap; gap: 32px 48px; justify-content: space-between; align-items: flex-start; }
  .p-page .p-lead { flex: 1 1 480px; max-width: 30ch; }
  .p-page .p-body { flex: 0 1 460px; font-size: 16px; line-height: 1.7; color: #2B3550; }
  .p-page .p-body p { margin: 0 0 16px; }
  .p-page .p-body > :last-child { margin-bottom: 0; }
  .p-page .p-grid { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; }
  .p-page .p-ph { overflow: hidden; }
  html.p-js .p-page .p-ph img { opacity: 0; transform: scale(1.03); transition: opacity 1s cubic-bezier(.16,1,.3,1), transform 1.4s cubic-bezier(.16,1,.3,1); }
  html.p-js .p-page .p-ph img.is-in { opacity: 1; transform: none; }
  .p-page .p-ph { position: relative; overflow: hidden; background: var(--tile); }
  .p-page .p-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .p-page .p-ph--half { grid-column: span 3; aspect-ratio: 4 / 5; }
  .p-page .p-ph--third { grid-column: span 2; aspect-ratio: 4 / 5; }
  .p-page .p-ph--full { grid-column: 1 / -1; aspect-ratio: 16 / 9; max-height: 820px; }
  .p-page .p-next { padding-block: var(--sec); }
  .p-page .p-next-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 24px; padding-top: 20px; border-top: 1px solid var(--line); margin-bottom: 32px; }
  .p-page .p-next-label { margin: 0; font-size: 14px; font-weight: 400; color: var(--mute); }
  .p-page .p-next-a { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: flex-end; color: #fff; }
  .p-page .p-next-a:hover { color: #fff; }
  .p-page .p-next-ph { position: relative; flex: 0 1 420px; aspect-ratio: 4 / 3; overflow: hidden; background: var(--tile); }
  .p-page .p-next-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.3,.6,.2,1); }
  .p-page .p-next-a:hover .p-next-ph img { transform: scale(1.03); }
  .p-page .p-next-txt { flex: 1 1 360px; display: grid; gap: 12px; }
  .p-page .p-next-name { font-weight: 800; font-size: clamp(30px, 4vw, 56px); line-height: .92; letter-spacing: -.045em; text-transform: uppercase; overflow-wrap: anywhere; }
  @media (max-width: 600px) {
    .p-page .t-pagehead .t-display { font-size: clamp(30px, 9vw, 44px); }
    .p-page .p-facts { flex-basis: 100%; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .p-page .p-cover { height: auto; aspect-ratio: 4 / 3; }
    .p-page .p-ph--half, .p-page .p-ph--third { grid-column: 1 / -1; }
    .p-page .p-ph--full { aspect-ratio: 4 / 3; }
    .p-page .p-next-ph { flex-basis: 100%; }
  }
</style>
