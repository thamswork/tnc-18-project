---
import { site } from "../../data/site";
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const socials = site.socials.filter((s) => s.href);
const icons: Record<string, string> = {
  Instagram: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none"/></svg>',
  TikTok: '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z"/></svg>',
  Facebook: '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
};
---
<footer class:list={["t-footer", { "t-footer--compact": compact }]}>
  <div class="t-wrap">
    {!compact && (
      <>
        <div class="t-footer-cta">
          <div>
            <h2 class="t-footer-h">Start a project</h2>
            <p class="t-footer-lead">Tell us what you are building and when it has to open.</p>
          </div>
          <div class="t-footer-btns">
            <a class="t-btn t-btn--line" href={site.lineUrl}>Chat on LINE</a>
            <a class="t-btn t-btn--ghost" href={site.phoneHref}>Call the studio</a>
          </div>
        </div>
        <dl class="t-footer-info">
          <div><dt>LINE</dt><dd><a href={site.lineUrl}>{site.lineId}</a></dd></div>
          <div><dt>Phone</dt><dd class="t-footer-stack"><a class="t-num" href={site.phoneHref}>{site.phoneDisplay}</a><a class="t-footer-sub t-num" href={site.officeHref}>Office {site.officeDisplay}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>Hours</dt><dd>{site.hours}</dd></div>
          <div class="t-footer-addr"><dt>Studio</dt><dd lang="th">
            <span class="t-footer-addr-name">{site.address.name}</span>
            {site.address.lines.map((l) => <span>{l}</span>)}
          </dd></div>
          {socials.length > 0 && <div class="t-footer-follow"><dt>Follow</dt><dd class="t-footer-social">{socials.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label} set:html={icons[s.label] ?? s.label}></a>)}</dd></div>}
        </dl>
      </>
    )}
    <div class="t-footer-bar">
      <span>© {new Date().getFullYear()} {site.company}</span>
      <nav aria-label="Footer">
        <a href="/portfolio">Work</a><a href="/about-services">Studio</a><a href="/specbook">Specbook</a><a href="/contact">Contact</a>
      </nav>
      <span>{site.city}</span>
    </div>
  </div>
</footer>

<script>
  // Hide the floating LINE button while the footer (which has its own LINE and Call buttons) is on screen
  const foot = document.querySelector(".t-footer-bar")?.closest("footer");
  if (foot && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => document.body.classList.toggle("is-foot", e.isIntersecting), { rootMargin: "0px 0px -15% 0px" }).observe(foot);
  }
</script>
