---
import { site } from "../../data/site";
interface Props { active?: "work" | "studio" | "specbook" | "contact"; overlay?: boolean }
const { active, overlay = false } = Astro.props;
const links = [
  { k: "work", label: "Work", href: "/portfolio" },
  { k: "studio", label: "Studio", href: "/about-services" },
  { k: "specbook", label: "Specbook", href: "/specbook" },
  { k: "contact", label: "Contact", href: "/contact" },
];
---
<header class:list={["t-header", { "t-header--overlay": overlay }]} data-header>
  <div class="t-wrap t-header-in">
    <a class="t-logo" href="/">TNC Build Studio</a>
    <nav class="t-nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={active === l.k ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <a class="t-header-line" href={site.lineUrl}><span class="t-dot" aria-hidden="true"></span>Chat on LINE</a>
    <div class="t-menu" data-menu>
      <button class="t-menu-btn" type="button" aria-expanded="false" aria-controls="t-menu-panel" aria-label="Open menu">
        <span class="t-burger" aria-hidden="true"><i></i><i></i></span>
      </button>
      <div class="t-menu-panel" id="t-menu-panel">
        <nav class="t-menu-nav" aria-label="Mobile">
          {links.map((l, i) => (
            <a class="t-menu-item" style={`--i:${i}`} href={l.href} aria-current={active === l.k ? "page" : undefined}>
              <span class="t-menu-n t-num">{String(i + 1).padStart(2, "0")}</span>{l.label}
            </a>
          ))}
        </nav>
        <div class="t-menu-foot t-menu-item" style="--i:4">
          <div class="t-menu-btns">
            <a class="t-btn t-btn--line" href={site.lineUrl}>Chat on LINE</a>
            <a class="t-btn t-btn--ghost" href={site.phoneHref}>Call</a>
          </div>
          <p class="t-menu-info"><span class="t-num">{site.phoneDisplay}</span> · {site.email}</p>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // The menu scrolls away with the page. Further down, it slides back in when
  // the visitor scrolls up, and slides away again when they scroll down.
  const h = document.querySelector<HTMLElement>("[data-header]");
  if (h) {
    let lastY = window.scrollY;
    let timer: number | undefined;
    let ticking = false;
    const limit = () => (h.classList.contains("t-header--overlay") ? window.innerHeight * 0.8 : 240);
    const reset = () => { window.clearTimeout(timer); h.classList.remove("is-stuck", "is-leaving"); };
    const show = () => { window.clearTimeout(timer); h.classList.remove("is-leaving"); h.classList.add("is-stuck"); };
    const hide = () => {
      if (!h.classList.contains("is-stuck") || h.classList.contains("is-leaving")) return;
      h.classList.add("is-leaving");
      timer = window.setTimeout(() => h.classList.remove("is-stuck", "is-leaving"), 450);
    };
    const update = () => {
      const y = window.scrollY;
      if (y < 80) reset();
      else if (y < lastY - 4 && y > limit()) show();
      else if (y > lastY + 4 && !h.querySelector(".t-menu.is-open")) hide();
      lastY = y;
      ticking = false;
    };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  }

  // Menu (tablet and phone): animated panel
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  if (menu) {
    const btn = menu.querySelector<HTMLButtonElement>(".t-menu-btn")!;
    const root = document.documentElement;
    const setOpen = (open: boolean) => {
      menu.classList.toggle("is-open", open);
      root.classList.toggle("menu-open", open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    btn.addEventListener("click", () => setOpen(!menu.classList.contains("is-open")));
    menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("is-open")) { setOpen(false); btn.focus(); }
    });
    window.matchMedia("(min-width: 961px)").addEventListener("change", (e) => { if (e.matches) setOpen(false); });
    window.addEventListener("pageshow", () => setOpen(false));
  }
</script>
